LANGUAGE 9, 1

/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.

IDI_VIVLAUNCHER       ICON         "vivlauncher.ico"
IDI_SMALL               ICON         "small.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDC_VIVLAUNCHER MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "E&xit",                IDM_EXIT
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About ...",           IDM_ABOUT
    END
END


/////////////////////////////////////////////////////////////////////////////
//
// Accelerator
//

IDC_VIVLAUNCHER ACCELERATORS
BEGIN
    "?",            IDM_ABOUT,              ASCII,  ALT
    "/",            IDM_ABOUT,              ASCII,  ALT
END


/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOGEX 0, 0, 170, 62
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About vivlauncher"
FONT 9, "Segoe UI"
BEGIN
    ICON            IDI_VIVLAUNCHER,IDC_STATIC,14,14,21,20
    LTEXT           "vivlauncher, Version 1.0",IDC_STATIC,42,14,114,8,SS_NOPREFIX
    LTEXT           "Copyright (c) 2026",IDC_STATIC,42,26,114,8
    DEFPUSHBUTTON   "OK",IDOK,113,41,50,14,WS_GROUP
END

IDD_VERSION_SELECTOR DIALOGEX 0, 0, 320, 180
STYLE DS_SETFONT | WS_POPUPWINDOW | WS_CAPTION | WS_SYSMENU
CAPTION "Select Vivado Version"
FONT 9, "Segoe UI"
BEGIN
    LISTBOX         IDC_VERSION_LIST,4,4,312,172,LBS_NOTIFY | LBS_OWNERDRAWFIXED | LBS_HASSTRINGS | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
END

IDD_ADD_PATH DIALOGEX 0, 0, 500, 100
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Add Vivado Path"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Enter Vivado installation path:",IDC_STATIC,14,14,470,12
    EDITTEXT        IDC_PATH_EDIT,14,30,396,20,ES_AUTOHSCROLL
    PUSHBUTTON      "Browse...",IDC_BROWSE_BUTTON,414,29,72,22,BS_OWNERDRAW
    DEFPUSHBUTTON   "Add",IDOK,288,64,98,24,BS_OWNERDRAW
    PUSHBUTTON      "Cancel",IDCANCEL,390,64,96,24,BS_OWNERDRAW
END

IDD_MAIN_DIALOG DIALOGEX 0, 0, 600, 356
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "Vivado Launcher"
FONT 9, "Segoe UI"
BEGIN
    LISTBOX         IDC_NAV_LIST,10,12,56,320,LBS_NOTIFY | LBS_OWNERDRAWFIXED | LBS_HASSTRINGS | LBS_NOINTEGRALHEIGHT | WS_TABSTOP
    LTEXT           "PROJECT",IDC_PROJECT_LABEL,78,14,90,10
    EDITTEXT        IDC_PROJECT_PATH,78,26,440,22,ES_AUTOHSCROLL
    PUSHBUTTON      "Browse",IDC_BROWSE_PROJECT,524,25,64,24,BS_OWNERDRAW
    LTEXT           "RECENT PROJECTS",IDC_RECENT_LABEL,78,56,120,10
    LISTBOX         IDC_RECENT_PROJECTS,78,68,240,164,LBS_NOTIFY | LBS_OWNERDRAWFIXED | LBS_HASSTRINGS | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    LTEXT           "VIVADO VERSIONS",IDC_INSTALL_LABEL,326,56,130,10
    LISTBOX         IDC_INSTALL_LIST,326,68,262,164,LBS_NOTIFY | LBS_OWNERDRAWFIXED | LBS_HASSTRINGS | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Refresh",IDC_REFRESH_INSTALLS,326,238,66,24,BS_OWNERDRAW
    PUSHBUTTON      "Add path",IDC_ADD_INSTALL,396,238,76,24,BS_OWNERDRAW
    PUSHBUTTON      "Set default",IDC_SET_DEFAULT,476,238,72,24,BS_OWNERDRAW
    CONTROL         "No log",IDC_NO_LOG,"Button",BS_OWNERDRAW | WS_TABSTOP,78,244,56,14
    CONTROL         "No journal",IDC_NO_JOURNAL,"Button",BS_OWNERDRAW | WS_TABSTOP,140,244,84,14
    LTEXT           "ADDITIONAL ARGUMENTS",IDC_ADDITIONAL_LABEL,78,262,150,10
    EDITTEXT        IDC_EXTRA_ARGS,78,274,510,22,ES_AUTOHSCROLL
    PUSHBUTTON      "Bind project",IDC_BIND_PROJECT,396,308,86,24,BS_OWNERDRAW
    DEFPUSHBUTTON   "Open project",IDC_OPEN_PROJECT,486,308,102,24,BS_OWNERDRAW
    LTEXT           "DIAGNOSTICS",IDC_DIAGNOSTIC_LABEL,78,14,120,10
    PUSHBUTTON      "View log",IDC_VIEW_LOG,78,28,72,24,BS_OWNERDRAW
    PUSHBUTTON      "Log folder",IDC_OPEN_LOG_FOLDER,154,28,80,24,BS_OWNERDRAW
    PUSHBUTTON      "Clear recent",IDC_CLEAR_RECENT,238,28,86,24,BS_OWNERDRAW
    PUSHBUTTON      "Config folder",IDC_OPEN_CONFIG_FOLDER,328,28,88,24,BS_OWNERDRAW
    PUSHBUTTON      "Associate .xpr",IDC_REGISTER_XPR,420,28,96,24,BS_OWNERDRAW
    LTEXT           "Log",IDC_LOG_LABEL,78,66,30,10
    EDITTEXT        IDC_LOG_PATH,112,64,476,22,ES_READONLY | ES_AUTOHSCROLL
    LTEXT           "Config",IDC_CONFIG_LABEL,78,94,40,10
    EDITTEXT        IDC_CONFIG_PATH,122,92,466,22,ES_READONLY | ES_AUTOHSCROLL
    LTEXT           "HELP",IDC_HELP_LABEL,78,14,60,10
    EDITTEXT        IDC_HELP_TEXT,78,28,510,304,ES_MULTILINE | ES_READONLY | WS_VSCROLL
    PUSHBUTTON      "Exit",IDCANCEL,78,308,48,24,BS_OWNERDRAW
END

