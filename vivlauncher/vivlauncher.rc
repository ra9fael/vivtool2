LANGUAGE 9, 1

/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.

IDI_VIVLAUNCHER       ICON         "vivlauncher.ico"
IDI_SMALL               ICON         "small.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDC_VIVLAUNCHER MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "E&xit",                IDM_EXIT
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About ...",           IDM_ABOUT
    END
END


/////////////////////////////////////////////////////////////////////////////
//
// Accelerator
//

IDC_VIVLAUNCHER ACCELERATORS
BEGIN
    "?",            IDM_ABOUT,              ASCII,  ALT
    "/",            IDM_ABOUT,              ASCII,  ALT
END


/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOGEX 0, 0, 170, 62
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About vivlauncher"
FONT 9, "Segoe UI"
BEGIN
    ICON            IDI_VIVLAUNCHER,IDC_STATIC,14,14,21,20
    LTEXT           "vivlauncher, Version 1.0",IDC_STATIC,42,14,114,8,SS_NOPREFIX
    LTEXT           "Copyright (c) 2026",IDC_STATIC,42,26,114,8
    DEFPUSHBUTTON   "OK",IDOK,113,41,50,14,WS_GROUP
END

IDD_VERSION_SELECTOR DIALOGEX 0, 0, 320, 180
STYLE DS_SETFONT | WS_POPUPWINDOW | WS_CAPTION | WS_SYSMENU
CAPTION "Select Vivado Version"
FONT 9, "Segoe UI"
BEGIN
    LISTBOX         IDC_VERSION_LIST,4,4,312,172,LBS_NOTIFY | LBS_OWNERDRAWFIXED | LBS_HASSTRINGS | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP | NOT WS_BORDER
END

IDD_ADD_PATH DIALOGEX 0, 0, 500, 100
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Add Vivado Path"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Enter Vivado installation path:",IDC_STATIC,14,14,470,12
    EDITTEXT        IDC_PATH_EDIT,14,30,396,20,ES_AUTOHSCROLL | NOT WS_BORDER
    PUSHBUTTON      "Browse...",IDC_BROWSE_BUTTON,414,29,72,22,BS_OWNERDRAW
    DEFPUSHBUTTON   "Add",IDOK,288,64,98,24,BS_OWNERDRAW
    PUSHBUTTON      "Cancel",IDCANCEL,390,64,96,24,BS_OWNERDRAW
END

IDD_MAIN_DIALOG DIALOGEX 0, 0, 470, 310
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "Vivado Launcher"
FONT 9, "Segoe UI"
BEGIN
    LISTBOX         IDC_NAV_LIST,10,10,52,290,LBS_NOTIFY | LBS_OWNERDRAWFIXED | LBS_HASSTRINGS | LBS_NOINTEGRALHEIGHT | WS_TABSTOP | NOT WS_BORDER
    LTEXT           "PROJECT",IDC_PROJECT_LABEL,72,12,90,10
    EDITTEXT        IDC_PROJECT_PATH,72,24,330,22,ES_AUTOHSCROLL | NOT WS_BORDER
    PUSHBUTTON      "Browse",IDC_BROWSE_PROJECT,406,23,54,24,BS_OWNERDRAW
    LTEXT           "RECENT PROJECTS",IDC_RECENT_LABEL,72,54,120,10
    LISTBOX         IDC_RECENT_PROJECTS,72,66,250,150,LBS_NOTIFY | LBS_OWNERDRAWFIXED | LBS_HASSTRINGS | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP | NOT WS_BORDER
    LTEXT           "VIVADO VERSIONS",IDC_INSTALL_LABEL,332,54,128,10
    LISTBOX         IDC_INSTALL_LIST,332,66,128,150,LBS_NOTIFY | LBS_OWNERDRAWFIXED | LBS_HASSTRINGS | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP | NOT WS_BORDER
    PUSHBUTTON      "Refresh",IDC_REFRESH_INSTALLS,332,222,38,22,BS_OWNERDRAW
    PUSHBUTTON      "Add path",IDC_ADD_INSTALL,374,222,40,22,BS_OWNERDRAW
    PUSHBUTTON      "Set default",IDC_SET_DEFAULT,418,222,42,22,BS_OWNERDRAW
    CONTROL         "No log",IDC_NO_LOG,"Button",BS_OWNERDRAW | WS_TABSTOP,72,226,52,12
    CONTROL         "No journal",IDC_NO_JOURNAL,"Button",BS_OWNERDRAW | WS_TABSTOP,128,226,72,12
    LTEXT           "ADDITIONAL ARGUMENTS",IDC_ADDITIONAL_LABEL,72,244,150,10
    EDITTEXT        IDC_EXTRA_ARGS,72,256,388,20,ES_AUTOHSCROLL | NOT WS_BORDER
    PUSHBUTTON      "Bind project",IDC_BIND_PROJECT,302,282,76,22,BS_OWNERDRAW
    DEFPUSHBUTTON   "Open project",IDC_OPEN_PROJECT,382,282,78,22,BS_OWNERDRAW
    LTEXT           "DIAGNOSTICS",IDC_DIAGNOSTIC_LABEL,72,12,120,10
    PUSHBUTTON      "View log",IDC_VIEW_LOG,72,26,64,22,BS_OWNERDRAW
    PUSHBUTTON      "Log folder",IDC_OPEN_LOG_FOLDER,140,26,72,22,BS_OWNERDRAW
    PUSHBUTTON      "Clear recent",IDC_CLEAR_RECENT,216,26,76,22,BS_OWNERDRAW
    PUSHBUTTON      "Config folder",IDC_OPEN_CONFIG_FOLDER,296,26,78,22,BS_OWNERDRAW
    PUSHBUTTON      "Associate .xpr",IDC_REGISTER_XPR,378,26,82,22,BS_OWNERDRAW
    LTEXT           "Log",IDC_LOG_LABEL,72,62,24,8
    EDITTEXT        IDC_LOG_PATH,106,58,354,16,ES_READONLY | ES_AUTOHSCROLL | NOT WS_BORDER
    LTEXT           "Config",IDC_CONFIG_LABEL,72,88,30,8
    EDITTEXT        IDC_CONFIG_PATH,106,84,354,16,ES_READONLY | ES_AUTOHSCROLL | NOT WS_BORDER
